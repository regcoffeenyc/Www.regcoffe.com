{
    "name": "01 — CEO Router",
    "flow": [
        {
            "id": 1,
            "module": "gateway:CustomWebHook",
            "version": 1,
            "parameters": {
                "hook": null,
                "maxResults": 1
            },
            "mapper": {},
            "metadata": {
                "designer": { "x": 0, "y": 0, "name": "Inbound event webhook (all agents + WooCommerce post here)" },
                "restore": {},
                "expect": []
            }
        },
        {
            "id": 2,
            "module": "datastore:AddEditRecord",
            "version": 1,
            "parameters": { "datastore": null },
            "mapper": {
                "key": "{{1.task_id}}",
                "data": {
                    "task_id": "{{1.task_id}}",
                    "from_agent": "{{1.from_agent}}",
                    "to_agent": "ceo",
                    "type": "{{1.type}}",
                    "payload_json": "{{1.payload_json}}",
                    "status": "received",
                    "priority": "{{1.priority}}",
                    "created_at": "{{now}}",
                    "deadline": "{{1.deadline}}"
                }
            },
            "metadata": {
                "designer": { "x": 300, "y": 0, "name": "Task Queue: log inbound task" },
                "notes": "Select the 'Task Queue' data store after import."
            }
        },
        {
            "id": 3,
            "module": "anthropic-claude:createMessage",
            "version": 1,
            "parameters": { "__IMTCONN__": null },
            "mapper": {
                "model": "claude-sonnet-4-6",
                "max_tokens": "1500",
                "system": "<<PASTE prompts/00-shared-conventions.md + prompts/01-ceo-orchestrator.md HERE>>",
                "messages": [
                    {
                        "role": "user",
                        "content": "Task envelope:\n{\"task_id\":\"{{1.task_id}}\",\"from_agent\":\"{{1.from_agent}}\",\"type\":\"{{1.type}}\",\"payload_json\":{{1.payload_json}},\"priority\":{{1.priority}},\"created_at\":\"{{now}}\",\"okr_snapshot\":{{1.okr_snapshot}},\"pending_approvals\":{{1.pending_approvals}}}"
                    }
                ]
            },
            "onerror": [
                {
                    "id": 20,
                    "module": "google-sheets:addRow",
                    "version": 2,
                    "parameters": { "__IMTCONN__": null },
                    "mapper": {
                        "values": {
                            "0": "{{now}}",
                            "1": "01 — CEO Router",
                            "2": "Claude API call",
                            "3": "{{20.message}}",
                            "4": "open"
                        }
                    },
                    "metadata": { "designer": { "x": 600, "y": 300, "name": "Error → Incidents sheet" }, "notes": "Select spreadsheet 'Company Brain', sheet 'Incidents'. Follow with a Break error handler set to 3 retries, exponential interval." }
                }
            ],
            "metadata": {
                "designer": { "x": 600, "y": 0, "name": "CEO agent brain (Claude)" },
                "notes": "Connection: your Anthropic API key. Paste the combined system prompt."
            }
        },
        {
            "id": 4,
            "module": "json:ParseJSON",
            "version": 1,
            "parameters": { "type": "" },
            "mapper": { "json": "{{3.body.content[].text}}" },
            "onerror": [
                {
                    "id": 21,
                    "module": "anthropic-claude:createMessage",
                    "version": 1,
                    "parameters": { "__IMTCONN__": null },
                    "mapper": {
                        "model": "claude-haiku-4-5",
                        "max_tokens": "1500",
                        "system": "You repair malformed JSON. Output ONLY the corrected JSON object matching the schema {action, parameters, needs_approval, escalate_to, log_message}. No commentary.",
                        "messages": [ { "role": "user", "content": "Repair this into valid JSON:\n{{3.body.content[].text}}" } ]
                    },
                    "metadata": { "designer": { "x": 900, "y": 300, "name": "JSON repair fallback (Haiku)" }, "notes": "After this module add json:ParseJSON on {{21.body.content[].text}} and a Resume error handler feeding the repaired bundle back." }
                }
            ],
            "metadata": { "designer": { "x": 900, "y": 0, "name": "Parse agent JSON" } }
        },
        {
            "id": 5,
            "module": "builtin:BasicRouter",
            "version": 1,
            "mapper": null,
            "metadata": { "designer": { "x": 1200, "y": 0, "name": "Route by action" } },
            "routes": [
                {
                    "flow": [
                        {
                            "id": 6,
                            "module": "datastore:AddEditRecord",
                            "version": 1,
                            "parameters": { "datastore": null },
                            "filter": {
                                "name": "action = route_task AND allowed agent",
                                "conditions": [
                                    [
                                        { "a": "{{4.action}}", "b": "route_task", "o": "text:equal" },
                                        { "a": "{{4.parameters.to_agent}}", "b": "chief_engineer|cfo|accountant|marketing|field|admin_supervisor", "o": "text:matchpattern" }
                                    ]
                                ]
                            },
                            "mapper": {
                                "key": "{{1.task_id}}-r",
                                "data": {
                                    "task_id": "{{1.task_id}}-r",
                                    "from_agent": "ceo",
                                    "to_agent": "{{4.parameters.to_agent}}",
                                    "type": "{{4.parameters.task_type}}",
                                    "payload_json": "{{4.parameters.payload}}",
                                    "status": "queued",
                                    "priority": "{{4.parameters.priority}}",
                                    "created_at": "{{now}}",
                                    "deadline": "{{addHours(now; 4.parameters.deadline_hours)}}"
                                }
                            },
                            "metadata": { "designer": { "x": 1500, "y": -300, "name": "Task Queue: enqueue routed task" } }
                        },
                        {
                            "id": 7,
                            "module": "http:ActionSendData",
                            "version": 3,
                            "parameters": { "handleErrors": true },
                            "mapper": {
                                "url": "<<TARGET AGENT SCENARIO WEBHOOK URL — use a Set Variable lookup table by to_agent>>",
                                "method": "post",
                                "headers": [],
                                "qs": [],
                                "bodyType": "raw",
                                "contentType": "application/json",
                                "data": "{\"task_id\":\"{{1.task_id}}-r\",\"from_agent\":\"ceo\",\"type\":\"{{4.parameters.task_type}}\",\"payload_json\":{{4.parameters.payload}},\"priority\":{{4.parameters.priority}}}"
                            },
                            "metadata": { "designer": { "x": 1800, "y": -300, "name": "Dispatch to target agent webhook" } }
                        }
                    ]
                },
                {
                    "flow": [
                        {
                            "id": 8,
                            "module": "telegram:SendReplyMessage",
                            "version": 1,
                            "parameters": { "__IMTCONN__": null },
                            "filter": {
                                "name": "needs human approval OR >500 GEL",
                                "conditions": [
                                    [ { "a": "{{4.action}}", "b": "request_human_approval", "o": "text:equal" } ],
                                    [ { "a": "{{4.needs_approval}}", "b": "true", "o": "boolean:equal" }, { "a": "{{4.parameters.amount_gel}}", "b": "500", "o": "number:greater" } ]
                                ]
                            },
                            "mapper": {
                                "chatId": "<<OWNER_TELEGRAM_CHAT_ID>>",
                                "text": "🔐 APPROVAL NEEDED\nTask: {{1.task_id}}\nSummary: {{4.parameters.summary_en}}\nAmount: {{4.parameters.amount_gel}} GEL\n\nApprove: <<APPROVAL_WEBHOOK_URL>>?task_id={{1.task_id}}&decision=approve\nReject: <<APPROVAL_WEBHOOK_URL>>?task_id={{1.task_id}}&decision=reject"
                            },
                            "metadata": { "designer": { "x": 1500, "y": 0, "name": "Human approval gate → Telegram" }, "notes": "Create a second tiny scenario with a custom webhook that receives ?task_id&decision and posts an approval_decision event back to this router." }
                        }
                    ]
                },
                {
                    "flow": [
                        {
                            "id": 9,
                            "module": "datastore:AddEditRecord",
                            "version": 1,
                            "parameters": { "datastore": null },
                            "filter": {
                                "name": "action = update_okr",
                                "conditions": [ [ { "a": "{{4.action}}", "b": "update_okr", "o": "text:equal" } ] ]
                            },
                            "mapper": {
                                "key": "okr-{{formatDate(now; 'YYYY-WW')}}-{{4.parameters.objective}}",
                                "data": {
                                    "objective": "{{4.parameters.objective}}",
                                    "key_result": "{{4.parameters.key_result}}",
                                    "value": "{{4.parameters.new_value}}",
                                    "note": "{{4.parameters.note}}",
                                    "updated_at": "{{now}}"
                                }
                            },
                            "metadata": { "designer": { "x": 1500, "y": 300, "name": "OKR memory (CEO Data Store)" }, "notes": "Select the 'CEO Memory' data store." }
                        }
                    ]
                },
                {
                    "flow": [
                        {
                            "id": 10,
                            "module": "google-sheets:addRow",
                            "version": 2,
                            "parameters": { "__IMTCONN__": null },
                            "mapper": {
                                "values": {
                                    "0": "{{now}}",
                                    "1": "ceo",
                                    "2": "{{4.action}}",
                                    "3": "{{4.log_message}}",
                                    "4": "{{4.escalate_to}}"
                                }
                            },
                            "metadata": { "designer": { "x": 1500, "y": 600, "name": "Fallback route: log decision to Company Brain" }, "notes": "No filter — this route always runs last and records every decision. Spreadsheet 'Company Brain', sheet 'Decisions'." }
                        }
                    ]
                }
            ]
        }
    ],
    "metadata": {
        "instant": true,
        "version": 1,
        "scenario": {
            "roundtrips": 1,
            "maxErrors": 3,
            "autoCommit": true,
            "autoCommitTriggerLast": true,
            "sequential": true,
            "confidential": false,
            "dlq": false,
            "freshVariables": false
        },
        "designer": { "orientation": "horizontal" },
        "zone": "eu1.make.com",
        "notes": [
            "After import: (1) create Data Stores per docs/03-data-stores.md and re-select them in modules 2, 6, 9; (2) link Anthropic, Telegram, Google Sheets connections; (3) paste system prompts; (4) replace <<PLACEHOLDERS>>; (5) set 'sequential' processing ON to keep task ordering."
        ]
    }
}
