{
    "name": "02 — Order to Fulfillment",
    "flow": [
        {
            "id": 1,
            "module": "gateway:CustomWebHook",
            "version": 1,
            "parameters": { "hook": null, "maxResults": 1 },
            "mapper": {},
            "metadata": {
                "designer": { "x": 0, "y": 0, "name": "WooCommerce 'order.updated' webhook" },
                "notes": "In WooCommerce: Settings → Advanced → Webhooks → topic 'Order updated' → this URL."
            }
        },
        {
            "id": 2,
            "module": "datastore:AddEditRecord",
            "version": 1,
            "parameters": { "datastore": null },
            "mapper": {
                "key": "{{1.id}}",
                "data": {
                    "order_id": "{{1.id}}",
                    "customer_name": "{{1.billing.first_name}} {{1.billing.last_name}}",
                    "email": "{{1.billing.email}}",
                    "phone": "{{1.billing.phone}}",
                    "city": "{{1.shipping.city}}",
                    "country": "{{1.shipping.country}}",
                    "total_gel": "{{1.total}}",
                    "payment_status": "{{1.status}}",
                    "fulfillment_status": "received",
                    "updated_at": "{{now}}"
                }
            },
            "metadata": { "designer": { "x": 300, "y": 0, "name": "Orders store: upsert" }, "notes": "Select 'Orders' data store." }
        },
        {
            "id": 3,
            "module": "anthropic-claude:createMessage",
            "version": 1,
            "parameters": { "__IMTCONN__": null },
            "filter": {
                "name": "only paid or COD orders",
                "conditions": [
                    [ { "a": "{{1.status}}", "b": "processing", "o": "text:equal" } ],
                    [ { "a": "{{1.payment_method}}", "b": "cod", "o": "text:equal" } ]
                ]
            },
            "mapper": {
                "model": "claude-sonnet-4-6",
                "max_tokens": "1500",
                "system": "<<PASTE prompts/00-shared-conventions.md + prompts/06-field-operations.md HERE>>",
                "messages": [
                    {
                        "role": "user",
                        "content": "{\"type\":\"new_order\",\"payload_json\":{\"order_id\":\"{{1.id}}\",\"customer\":{\"name\":\"{{1.billing.first_name}} {{1.billing.last_name}}\",\"phone\":\"{{1.billing.phone}}\",\"email\":\"{{1.billing.email}}\",\"address\":\"{{1.shipping.address_1}}\",\"city\":\"{{1.shipping.city}}\",\"country\":\"{{1.shipping.country}}\"},\"lines\":{{1.line_items}},\"total_gel\":{{1.total}},\"payment_status\":\"{{if(1.status = 'processing'; 'paid'; 1.status)}}\",\"payment_method\":\"{{1.payment_method}}\"}}"
                    }
                ]
            },
            "onerror": [
                {
                    "id": 20,
                    "module": "google-sheets:addRow",
                    "version": 2,
                    "parameters": { "__IMTCONN__": null },
                    "mapper": { "values": { "0": "{{now}}", "1": "02 — Order to Fulfillment", "2": "Field agent Claude call", "3": "{{20.message}}", "4": "open" } },
                    "metadata": { "designer": { "x": 600, "y": 300, "name": "Error → Incidents" }, "notes": "Add Break handler: 3 retries, exponential." }
                }
            ],
            "metadata": { "designer": { "x": 600, "y": 0, "name": "Field agent brain (Claude)" } }
        },
        {
            "id": 4,
            "module": "json:ParseJSON",
            "version": 1,
            "parameters": { "type": "" },
            "mapper": { "json": "{{3.body.content[].text}}" },
            "metadata": { "designer": { "x": 900, "y": 0, "name": "Parse agent JSON" }, "notes": "Attach the same Haiku JSON-repair onerror pattern as in scenario 01." }
        },
        {
            "id": 5,
            "module": "builtin:BasicRouter",
            "version": 1,
            "mapper": null,
            "metadata": { "designer": { "x": 1200, "y": 0, "name": "Route by action" } },
            "routes": [
                {
                    "flow": [
                        {
                            "id": 6,
                            "module": "datastore:AddEditRecord",
                            "version": 1,
                            "parameters": { "datastore": null },
                            "filter": {
                                "name": "create_pick_task",
                                "conditions": [ [ { "a": "{{4.action}}", "b": "create_pick_task", "o": "text:equal" } ] ]
                            },
                            "mapper": {
                                "key": "{{4.parameters.order_id}}",
                                "data": { "fulfillment_status": "picking", "pick_notes": "{{4.parameters.notes}}", "updated_at": "{{now}}" }
                            },
                            "metadata": { "designer": { "x": 1500, "y": -450, "name": "Orders store: status → picking" } }
                        },
                        {
                            "id": 7,
                            "module": "email:ActionSendEmail",
                            "version": 7,
                            "parameters": { "account": null, "saveAfterSent": false },
                            "mapper": {
                                "to": [ "<<WAREHOUSE_PACKER_EMAIL>>" ],
                                "subject": "PICK: order {{4.parameters.order_id}}",
                                "contentType": "text",
                                "text": "Pick task for order {{4.parameters.order_id}}. Lines: {{4.parameters.lines}}. Notes: {{4.parameters.notes}}. Reply DONE-{{4.parameters.order_id}} when packed."
                            },
                            "metadata": { "designer": { "x": 1800, "y": -450, "name": "Notify packer" }, "notes": "Swap for Telegram/Slack module if the packer prefers." }
                        }
                    ]
                },
                {
                    "flow": [
                        {
                            "id": 8,
                            "module": "http:ActionSendData",
                            "version": 3,
                            "parameters": { "handleErrors": true },
                            "filter": {
                                "name": "book_courier",
                                "conditions": [ [ { "a": "{{4.action}}", "b": "book_courier", "o": "text:equal" } ] ]
                            },
                            "mapper": {
                                "url": "<<COURIER_API_OR_EMAIL_GATEWAY>>",
                                "method": "post",
                                "bodyType": "raw",
                                "contentType": "application/json",
                                "data": "{\"courier\":\"{{4.parameters.courier}}\",\"order_id\":\"{{4.parameters.order_id}}\",\"pickup_date\":\"{{4.parameters.pickup_date}}\",\"recipient\":\"{{4.parameters.recipient}}\",\"address\":\"{{4.parameters.address}}\",\"cod_gel\":{{4.parameters.cod_gel}},\"weight_kg\":{{4.parameters.weight_kg}}}"
                            },
                            "metadata": { "designer": { "x": 1500, "y": -150, "name": "Book courier (local/GPost/DHL)" }, "notes": "Local courier: usually an email booking — replace with email module. DHL: use MyDHL API with your account. Store returned tracking number via a following Data Store update." }
                        }
                    ]
                },
                {
                    "flow": [
                        {
                            "id": 9,
                            "module": "email:ActionSendEmail",
                            "version": 7,
                            "parameters": { "account": null, "saveAfterSent": false },
                            "filter": {
                                "name": "send_tracking (email)",
                                "conditions": [ [ { "a": "{{4.action}}", "b": "send_tracking", "o": "text:equal" } ] ]
                            },
                            "mapper": {
                                "to": [ "{{1.billing.email}}" ],
                                "subject": "Order {{4.parameters.order_id}} — tracking / თრექინგი",
                                "contentType": "text",
                                "text": "{{4.parameters.text_ka}}\n\n---\n\n{{4.parameters.text_en}}"
                            },
                            "metadata": { "designer": { "x": 1500, "y": 150, "name": "Tracking → customer (email)" }, "notes": "For WhatsApp add a parallel route with the WhatsApp Business Cloud module 'Send a Message' filtered on channel=whatsapp." }
                        }
                    ]
                },
                {
                    "flow": [
                        {
                            "id": 10,
                            "module": "http:ActionSendData",
                            "version": 3,
                            "parameters": { "handleErrors": true },
                            "filter": {
                                "name": "hold / RMA / approval-needed → CEO router",
                                "conditions": [
                                    [ { "a": "{{4.action}}", "b": "hold_order", "o": "text:equal" } ],
                                    [ { "a": "{{4.action}}", "b": "open_rma", "o": "text:equal" } ],
                                    [ { "a": "{{4.needs_approval}}", "b": "true", "o": "boolean:equal" } ]
                                ]
                            },
                            "mapper": {
                                "url": "<<CEO_ROUTER_WEBHOOK_URL>>",
                                "method": "post",
                                "bodyType": "raw",
                                "contentType": "application/json",
                                "data": "{\"task_id\":\"field-{{1.id}}-{{timestamp}}\",\"from_agent\":\"field\",\"type\":\"approval_request\",\"payload_json\":{{4}},\"priority\":2}"
                            },
                            "metadata": { "designer": { "x": 1500, "y": 450, "name": "Escalate to CEO router" } }
                        }
                    ]
                }
            ]
        }
    ],
    "metadata": {
        "instant": true,
        "version": 1,
        "scenario": {
            "roundtrips": 1,
            "maxErrors": 3,
            "autoCommit": true,
            "autoCommitTriggerLast": true,
            "sequential": true,
            "confidential": false,
            "dlq": false,
            "freshVariables": false
        },
        "designer": { "orientation": "horizontal" },
        "zone": "eu1.make.com",
        "notes": [
            "Shopify variant: replace module 1 with the Shopify 'Watch Orders' instant trigger and adjust field mappings (1.id → order id, 1.total_price, etc.)."
        ]
    }
}
