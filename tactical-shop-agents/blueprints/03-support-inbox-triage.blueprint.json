{
    "name": "03 — Support Inbox Triage",
    "flow": [
        {
            "id": 1,
            "module": "gateway:CustomWebHook",
            "version": 1,
            "parameters": { "hook": null, "maxResults": 1 },
            "mapper": {},
            "metadata": {
                "designer": { "x": 0, "y": 0, "name": "Unified inbox webhook" },
                "notes": "Three tiny feeder scenarios post here in a normalized shape {channel, customer, message_text, order_id?, thread_id, received_at}: (a) Email 'Watch Emails' → HTTP POST, (b) WhatsApp Business Cloud 'Watch Events' → HTTP POST, (c) Facebook Messenger 'Watch Messages' → HTTP POST. See docs/02-build-instructions.md §Feeders."
            }
        },
        {
            "id": 2,
            "module": "datastore:AddEditRecord",
            "version": 1,
            "parameters": { "datastore": null },
            "mapper": {
                "key": "{{1.thread_id}}",
                "data": {
                    "thread_id": "{{1.thread_id}}",
                    "channel": "{{1.channel}}",
                    "customer_handle": "{{1.customer.handle}}",
                    "last_message": "{{1.message_text}}",
                    "order_id": "{{1.order_id}}",
                    "status": "open",
                    "received_at": "{{1.received_at}}",
                    "sla_deadline": "{{addHours(1.received_at; 2)}}"
                }
            },
            "metadata": { "designer": { "x": 300, "y": 0, "name": "Customers/Threads store: upsert" }, "notes": "Select 'Customers' data store." }
        },
        {
            "id": 3,
            "module": "datastore:SearchRecords",
            "version": 1,
            "parameters": { "datastore": null },
            "mapper": {
                "filter": [ [ { "a": "order_id", "b": "{{1.order_id}}", "o": "text:equal" } ] ],
                "limit": "1"
            },
            "metadata": { "designer": { "x": 600, "y": 0, "name": "Look up order/tracking context" }, "notes": "Select 'Orders' data store. Returns tracking state so the agent can answer status questions." }
        },
        {
            "id": 4,
            "module": "anthropic-claude:createMessage",
            "version": 1,
            "parameters": { "__IMTCONN__": null },
            "mapper": {
                "model": "claude-sonnet-4-6",
                "max_tokens": "1500",
                "system": "<<PASTE prompts/00-shared-conventions.md + prompts/07-admin-supervisor.md HERE>>",
                "messages": [
                    {
                        "role": "user",
                        "content": "{\"type\":\"support_message\",\"payload_json\":{\"channel\":\"{{1.channel}}\",\"customer\":{{1.customer}},\"message_text\":\"{{1.message_text}}\",\"language_guess\":\"{{1.language_guess}}\",\"order_id\":\"{{1.order_id}}\",\"thread_id\":\"{{1.thread_id}}\",\"thread_history\":{{1.thread_history}},\"received_at\":\"{{1.received_at}}\",\"tracking_state\":{{3.fulfillment_status}}}}"
                    }
                ]
            },
            "onerror": [
                {
                    "id": 20,
                    "module": "google-sheets:addRow",
                    "version": 2,
                    "parameters": { "__IMTCONN__": null },
                    "mapper": { "values": { "0": "{{now}}", "1": "03 — Support Inbox Triage", "2": "Admin agent Claude call", "3": "{{20.message}}", "4": "open" } },
                    "metadata": { "designer": { "x": 900, "y": 300, "name": "Error → Incidents" }, "notes": "Add Break handler: 3 retries, exponential." }
                }
            ],
            "metadata": { "designer": { "x": 900, "y": 0, "name": "Admin Supervisor brain (Claude)" } }
        },
        {
            "id": 5,
            "module": "json:ParseJSON",
            "version": 1,
            "parameters": { "type": "" },
            "mapper": { "json": "{{4.body.content[].text}}" },
            "metadata": { "designer": { "x": 1200, "y": 0, "name": "Parse agent JSON" }, "notes": "Attach the Haiku JSON-repair onerror pattern from scenario 01." }
        },
        {
            "id": 6,
            "module": "builtin:BasicRouter",
            "version": 1,
            "mapper": null,
            "metadata": { "designer": { "x": 1500, "y": 0, "name": "Route by action" } },
            "routes": [
                {
                    "flow": [
                        {
                            "id": 7,
                            "module": "builtin:BasicRouter",
                            "version": 1,
                            "mapper": null,
                            "filter": {
                                "name": "auto_reply AND no approval",
                                "conditions": [ [ { "a": "{{5.action}}", "b": "auto_reply", "o": "text:equal" }, { "a": "{{5.needs_approval}}", "b": "false", "o": "boolean:equal" } ] ]
                            },
                            "metadata": { "designer": { "x": 1800, "y": -300, "name": "Split by channel" } },
                            "routes": [
                                {
                                    "flow": [
                                        {
                                            "id": 8,
                                            "module": "email:ActionSendEmail",
                                            "version": 7,
                                            "parameters": { "account": null, "saveAfterSent": false },
                                            "filter": { "name": "email", "conditions": [ [ { "a": "{{1.channel}}", "b": "email", "o": "text:equal" } ] ] },
                                            "mapper": {
                                                "to": [ "{{1.customer.email}}" ],
                                                "subject": "Re: your message / თქვენი შეტყობინება",
                                                "contentType": "text",
                                                "text": "{{if(5.parameters.reply_language = 'en'; 5.parameters.text_en; if(5.parameters.reply_language = 'ka'; 5.parameters.text_ka; 5.parameters.text_ka + newline + newline + '---' + newline + 5.parameters.text_en))}}"
                                            },
                                            "metadata": { "designer": { "x": 2100, "y": -450, "name": "Reply via email" } }
                                        }
                                    ]
                                },
                                {
                                    "flow": [
                                        {
                                            "id": 9,
                                            "module": "http:ActionSendData",
                                            "version": 3,
                                            "parameters": { "handleErrors": true },
                                            "filter": { "name": "whatsapp or messenger", "conditions": [ [ { "a": "{{1.channel}}", "b": "whatsapp|messenger", "o": "text:matchpattern" } ] ] },
                                            "mapper": {
                                                "url": "<<WHATSAPP_OR_MESSENGER_SEND_ENDPOINT>>",
                                                "method": "post",
                                                "bodyType": "raw",
                                                "contentType": "application/json",
                                                "data": "{\"to\":\"{{1.customer.handle}}\",\"channel\":\"{{1.channel}}\",\"text\":\"{{if(5.parameters.reply_language = 'en'; 5.parameters.text_en; 5.parameters.text_ka)}}\"}"
                                            },
                                            "metadata": { "designer": { "x": 2100, "y": -150, "name": "Reply via WhatsApp/Messenger" }, "notes": "Prefer the native 'WhatsApp Business Cloud → Send a Message' and 'Facebook Messenger → Send a Message' modules once connections exist; HTTP shown for portability." }
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "flow": [
                        {
                            "id": 10,
                            "module": "telegram:SendReplyMessage",
                            "version": 1,
                            "parameters": { "__IMTCONN__": null },
                            "filter": {
                                "name": "draft_reply → human review",
                                "conditions": [ [ { "a": "{{5.action}}", "b": "draft_reply", "o": "text:equal" } ] ]
                            },
                            "mapper": {
                                "chatId": "<<OWNER_TELEGRAM_CHAT_ID>>",
                                "text": "✍️ DRAFT REPLY needs review\nThread: {{1.thread_id}} ({{1.channel}})\nReason: {{5.parameters.reason_for_review}}\n\nKA: {{5.parameters.text_ka}}\n\nEN: {{5.parameters.text_en}}\n\nSend: <<APPROVAL_WEBHOOK_URL>>?thread_id={{1.thread_id}}&decision=send"
                            },
                            "metadata": { "designer": { "x": 1800, "y": 0, "name": "Draft → owner review (Telegram)" } }
                        }
                    ]
                },
                {
                    "flow": [
                        {
                            "id": 11,
                            "module": "http:ActionSendData",
                            "version": 3,
                            "parameters": { "handleErrors": true },
                            "filter": {
                                "name": "triage → CEO router",
                                "conditions": [ [ { "a": "{{5.action}}", "b": "triage", "o": "text:equal" } ] ]
                            },
                            "mapper": {
                                "url": "<<CEO_ROUTER_WEBHOOK_URL>>",
                                "method": "post",
                                "bodyType": "raw",
                                "contentType": "application/json",
                                "data": "{\"task_id\":\"sup-{{1.thread_id}}-{{timestamp}}\",\"from_agent\":\"admin_supervisor\",\"type\":\"support_message\",\"payload_json\":{{5}},\"priority\":{{5.parameters.severity}}}"
                            },
                            "metadata": { "designer": { "x": 1800, "y": 300, "name": "Escalate triaged thread to CEO router" } }
                        }
                    ]
                },
                {
                    "flow": [
                        {
                            "id": 12,
                            "module": "google-sheets:addRow",
                            "version": 2,
                            "parameters": { "__IMTCONN__": null },
                            "mapper": {
                                "values": { "0": "{{now}}", "1": "admin_supervisor", "2": "{{5.action}}", "3": "{{5.log_message}}", "4": "{{1.thread_id}}" }
                            },
                            "metadata": { "designer": { "x": 1800, "y": 600, "name": "Log every triage decision" }, "notes": "Spreadsheet 'Company Brain', sheet 'Decisions'. No filter — always runs." }
                        }
                    ]
                }
            ]
        }
    ],
    "metadata": {
        "instant": true,
        "version": 1,
        "scenario": {
            "roundtrips": 1,
            "maxErrors": 3,
            "autoCommit": true,
            "autoCommitTriggerLast": true,
            "sequential": false,
            "confidential": false,
            "dlq": false,
            "freshVariables": false
        },
        "designer": { "orientation": "horizontal" },
        "zone": "eu1.make.com",
        "notes": [
            "SLA watchdog is a separate 15-minute scheduled scenario (see docs/02-build-instructions.md): search 'Customers' store for status=open AND sla_deadline < now → Telegram sla_alert."
        ]
    }
}
